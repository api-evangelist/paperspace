{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paperspace Container Registries Activity Custom Templates API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
