            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a custom template from a machine."
        },
        {
          "info": {
            "name": "Get Custom Template",
            "type": "http"
          },
          "http": {
            "method": "GET",
