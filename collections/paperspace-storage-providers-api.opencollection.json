          },
          "docs": "Lists external storage providers configured for the team."
        },
        {
          "info": {
            "name": "Create Storage Provider",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.paperspace.com/v1/storage-providers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new storage provider configuration."
        },
        {
          "info": {
            "name": "Get Storage Provider",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paperspace.com/v1/storage-providers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Gets a storage provider."
        },
        {
          "info": {
            "name": "Update Storage Provider",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.paperspace.com/v1/storage-providers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a storage provider."
        },
        {
          "info": {
            "name": "Delete Storage Provider",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.paperspace.com/v1/storage-providers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a storage provider."
        },
        {
          "info": {
            "name": "Get Storage Utilization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paperspace.com/v1/storage-providers/utilization"
          },
          "docs": "Retrieves team storage usage breakdown across datasets, models, notebooks, and shared storage."
        }
      ]
    }
  ],
  "bundled": true
}