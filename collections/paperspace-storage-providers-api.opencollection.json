{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paperspace Container Registries Activity Storage Providers API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Storage Providers",
        "type": "folder"
      },
      "items": [
