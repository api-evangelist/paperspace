{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paperspace Container Registries Activity Team Members API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Team Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Team Members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paperspace.com/v1/teams/:teamId/users",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Lists team members."
        },
        {
          "info": {
            "name": "Update Team Member",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.paperspace.com/v1/teams/:teamId/users/:userId",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              },
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Modifies a member's admin status within a team."
        },
        {
          "info": {
            "name": "Remove Team Member",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.paperspace.com/v1/teams/:teamId/users/:userId",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              },
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Eliminates a user from team membership."
        }
      ]
    }
  ],
  "bundled": true
}